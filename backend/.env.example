# ---------------------------------------------------------------------------
# DealFlow360 backend environment configuration
# Copy this file to backend/.env and fill in the real values.
# ---------------------------------------------------------------------------

# PostgreSQL connection (the ONLY application database).
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/dealflow360

# Set to true to log every SQL statement issued by SQLAlchemy.
SQL_ECHO=false

# JWT signing configuration (used from Step 4 onwards).
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Comma-separated list of origins allowed to call this API (the Vite dev server).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

APP_ENV=development
