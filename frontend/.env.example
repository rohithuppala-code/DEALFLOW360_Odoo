# ---------------------------------------------------------------------------
# DealFlow360 frontend configuration
#
# Copy to frontend/.env and fill in from your Supabase project:
#   Supabase dashboard -> Project Settings -> API
#
# Everything prefixed VITE_ is compiled into the browser bundle and is public.
# ONLY the anon key belongs here.
#
# NEVER put SUPABASE_SERVICE_ROLE_KEY in this file. It bypasses Row Level
# Security entirely; in a VITE_ variable it would be shipped to every visitor.
# It lives in backend/.env and nowhere else.
# ---------------------------------------------------------------------------

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Base URL of the FastAPI backend. Leave unset in development to use the Vite
# proxy in vite.config.js, which keeps the browser on a single origin.
# VITE_API_BASE_URL=http://127.0.0.1:8000/api
